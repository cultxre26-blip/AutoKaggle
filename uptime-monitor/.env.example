PORT=3000
APP_URL=http://localhost:3000
# 32+ random chars; signs nothing sensitive but keep it set in production
SESSION_SECRET=change-me
DATABASE_PATH=./data/pingwatch.db
# Stripe (billing is disabled when STRIPE_SECRET_KEY is empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# SMTP (alerts are logged to stdout when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PingWatch <alerts@example.com>
# Set to 1 only for local testing: allows monitoring localhost/private IPs
ALLOW_PRIVATE_TARGETS=0
# Number of reverse proxies in front of the app (used for client IPs and rate limits)
TRUST_PROXY=1
# Optional Cloudflare Turnstile human check on signup (set both or neither)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# docker-compose only: public domain for automatic HTTPS
DOMAIN=pingwatch.example.com
# Shown in the terms and privacy pages (required in production)
COMPANY_NAME=Example Ltd
SUPPORT_EMAIL=support@example.com
